<?xml version='1.0' encoding='utf-8' ?>

<!--
  twbdoc 検証用の手書きサンプル。実twbファイルではない（実ファイルはコミットしない方針のため）。
  以下を意図的に網羅している:
    - データソース2つ（うち1つはカスタムSQL）
    - 計算フィールド6種（単純集計/ネスト/LOD/表計算/コメント付き/文字列リテラル内に紛らわしい角括弧を含むもの）
    - パラメータ2種（range型・list型）
    - グループ・ビン・フォルダ
    - ワークシート4枚（棒グラフ/折れ線/散布図/クロス集計）
    - ダッシュボード2枚（ゾーンの入れ子）
    - アクション3種（フィルタ/URL/未知の種別）
    - 未知の要素（workbook直下・datasource内・dashboard内に1つずつ）

  公式XSD（tableau/tableau-document-schemas, twb_2026.1.0.xsd）に対して実際に検証し、
  以下は指摘を受けて修正済み: <calculation class='bin'>の形、<folders-common>でのfolder包含順、
  <alphabetic-sort>等の実際のソート要素名、<view>直下の<aggregation>/<style>必須要素、
  各<pane>の<view><breakdown/></view>、ワークシート/ダッシュボードの<simple-id>、
  selection-relaxation-optionの列挙値、detail→lodのエンコーディングチャネル名、
  <range granularity>属性名。

  唯一未解決: <actions>内の<source>/<target>/<filter>構造とactivationの表現は、
  本ファイルは実務でよく見る2019〜2023年台のTableauが出力する形（source/target/filterの
  ネスト構造、activation属性）を踏襲しており、2026.1スキーマが定めるより新しい表現
  （<activation>要素化、<source type='sheet'>+<exclude-sheet>によるsheet除外方式、
  <command>/<param>によるアクション種別の汎用表現）とは一致しない。この新方式の実例を
  手元で確認できないため、確度の低い当てずっぽうで書き換えるより現状の広く見られる形を
  残す判断とした。twbdocのアクションパーサ自体もこの旧方式を前提にしている
  （parse.pyのUnparsedElement機構により、未知の子要素があれば例外を投げず報告する）。
-->
<workbook source-build='2023.3.1 (20233.23.1005.1746)' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <SheetIdentifierTracking />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
  </preferences>
  <semantic-model-refs>
    <!-- 将来のTableauバージョンで追加されるかもしれない未知の要素を想定したダミー -->
    <semantic-model-ref name='future-thing' />
  </semantic-model-refs>

  <datasources>
    <datasource caption='Sales (Orders)' name='federated.0dw1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='PostgreSQL' name='postgres.0abc'>
            <connection authentication='username-password' class='postgres' dbname='sales_db' port='5432' server='db.example.internal' />
          </named-connection>
        </named-connections>
        <relation name='Orders' table='[public].[orders]' type='table' />
      </connection>
      <aliases enabled='yes' />

      <!-- 想定外の子要素（未対応要素レポートに載るはず） -->
      <parameters-are-actually-different-in-2027 foo='bar' />

      <column caption='注文ID' datatype='string' name='[Order ID]' role='dimension' type='nominal' />
      <column caption='売上' datatype='real' default-aggregation='Sum' name='[Sales]' role='measure' type='quantitative' />
      <column caption='利益' datatype='real' default-aggregation='Sum' name='[Profit]' role='measure' type='quantitative' />
      <column caption='数量' datatype='integer' default-aggregation='Sum' name='[Quantity]' role='measure' type='quantitative' />
      <column caption='割引率' datatype='real' default-aggregation='Avg' name='[Discount]' role='measure' type='quantitative' />
      <column caption='注文日' datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
      <column caption='出荷日' datatype='date' name='[Ship Date]' role='dimension' type='ordinal' />
      <column caption='地域' datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column caption='カテゴリ' datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column caption='顧客ID' datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
      <column caption='セグメント' datatype='string' name='[Segment]' role='dimension' type='nominal' />

      <column caption='売上ビン(1000刻み)' datatype='real' name='[Sales (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' column='[Sales]' new-bin='true' size='1000' />
      </column>

      <column caption='利益率' datatype='real' name='[Calculation_1000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='利益率区分' datatype='string' name='[Calculation_1000000000002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1000000000001] &gt; 0.2 THEN &quot;高収益&quot; ELSEIF [Calculation_1000000000001] &gt; 0 THEN &quot;通常&quot; ELSE &quot;赤字&quot; END' />
      </column>
      <column caption='顧客別売上(FIXED)' datatype='real' name='[Calculation_1000000000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Customer ID] : SUM([Sales])}' />
      </column>
      <column caption='売上ランク' datatype='integer' name='[Calculation_1000000000004]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK(SUM([Sales]))' />
      </column>
      <column caption='単価' datatype='real' name='[Calculation_1000000000005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 数量ゼロ割対策&#10;ZN(SUM([Sales])) / ZN(SUM([Quantity]))' />
      </column>
      <column caption='表示ラベル' datatype='string' name='[Calculation_1000000000006]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;[要確認] &quot; + [Category]' />
      </column>

      <group name='[主要地域グループ]' caption='主要地域グループ'>
        <groupfilter function='union'>
          <groupfilter function='member' level='[Region]' member='&quot;関東&quot;' />
          <groupfilter function='member' level='[Region]' member='&quot;関西&quot;' />
        </groupfilter>
      </group>

      <folders-common>
        <folder name='売上関連'>
          <folder-item name='[Sales]' type='field' />
          <folder-item name='[Profit]' type='field' />
          <folder-item name='[Calculation_1000000000001]' type='field' />
          <folder-item name='[Calculation_1000000000002]' type='field' />
        </folder>
        <folder name='顧客属性'>
          <folder-item name='[Customer ID]' type='field' />
          <folder-item name='[Segment]' type='field' />
        </folder>
      </folders-common>
    </datasource>

    <datasource caption='Web Log (Custom SQL)' name='federated.0dw2' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Snowflake' name='snowflake.0def'>
            <connection authentication='username-password' class='snowflake' dbname='analytics' server='xy12345.snowflakecomputing.com' />
          </named-connection>
        </named-connections>
        <relation name='Custom SQL Query' type='text'>SELECT session_id, page_views, visit_date, device
FROM web.sessions
WHERE visit_date &gt;= '2024-01-01'</relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='セッションID' datatype='string' name='[Session ID]' role='dimension' type='nominal' />
      <column caption='ページビュー数' datatype='integer' default-aggregation='Sum' name='[Page Views]' role='measure' type='quantitative' />
      <column caption='訪問日' datatype='date' name='[Visit Date]' role='dimension' type='ordinal' />
      <column caption='デバイス' datatype='string' name='[Device]' role='dimension' type='nominal' />
    </datasource>

    <datasource caption='Parameters' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='目標利益率' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.15'>
        <calculation class='tableau' formula='0.15' />
        <range granularity='0.01' max='1' min='0' />
      </column>
      <column caption='表示期間' datatype='string' name='[Parameter 2]' param-domain-type='list' role='dimension' type='nominal' value='&quot;直近12ヶ月&quot;'>
        <calculation class='tableau' formula='&quot;直近12ヶ月&quot;' />
        <members>
          <member value='&quot;直近3ヶ月&quot;' />
          <member value='&quot;直近12ヶ月&quot;' />
          <member value='&quot;全期間&quot;' />
        </members>
      </column>
    </datasource>
  </datasources>

  <worksheets>
    <worksheet name='地域別売上'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales (Orders)' name='federated.0dw1' />
          </datasources>
          <datasource-dependencies datasource='federated.0dw1'>
            <column caption='地域' datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='売上' datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column caption='セグメント' datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column caption='表示ラベル' datatype='string' name='[Calculation_1000000000006]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0dw1].[Region]'>
            <groupfilter function='union'>
              <groupfilter function='member' level='[federated.0dw1].[Region]' member='&quot;関東&quot;' />
              <groupfilter function='member' level='[federated.0dw1].[Region]' member='&quot;関西&quot;' />
            </groupfilter>
          </filter>
          <alphabetic-sort />
        <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.0dw1].[Region]' />
              <lod column='[federated.0dw1].[Segment]' />
              <tooltip column='[federated.0dw1].[Calculation_1000000000006]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0dw1].[sum:Sales:qk]</rows>
        <cols>[federated.0dw1].[none:Region:nk]</cols>
      </table>
      <simple-id uuid='{A57CB2E0-3B1F-4210-B610-8D9EB906ED28}' />
    </worksheet>

    <worksheet name='月次売上推移'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales (Orders)' name='federated.0dw1' />
          </datasources>
          <datasource-dependencies datasource='federated.0dw1'>
            <column caption='注文日' datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column caption='売上' datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column caption='カテゴリ' datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='単価' datatype='real' name='[Calculation_1000000000005]' role='measure' type='quantitative' />
          </datasource-dependencies>
        <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.0dw1].[Category]' />
              <size column='[federated.0dw1].[Calculation_1000000000005]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0dw1].[sum:Sales:qk]</rows>
        <cols>[federated.0dw1].[tmonth:Order Date:ok]</cols>
      </table>
      <simple-id uuid='{86B99910-C5F6-42AB-B9F2-7209CF85DBF3}' />
    </worksheet>

    <worksheet name='利益率散布図'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales (Orders)' name='federated.0dw1' />
          </datasources>
          <datasource-dependencies datasource='federated.0dw1'>
            <column caption='利益率' datatype='real' name='[Calculation_1000000000001]' role='measure' type='quantitative' />
            <column caption='利益率区分' datatype='string' name='[Calculation_1000000000002]' role='dimension' type='nominal' />
            <column caption='売上' datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column caption='利益' datatype='real' name='[Profit]' role='measure' type='quantitative' />
          </datasource-dependencies>
        <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.0dw1].[Calculation_1000000000002]' />
              <size column='[federated.0dw1].[sum:Profit:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0dw1].[Calculation_1000000000001]</rows>
        <cols>[federated.0dw1].[sum:Sales:qk]</cols>
      </table>
      <simple-id uuid='{6FA22D68-4FDB-416A-AE3B-E0F29DCAA8D3}' />
    </worksheet>

    <worksheet name='顧客別集計(クロス集計)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales (Orders)' name='federated.0dw1' />
          </datasources>
          <datasource-dependencies datasource='federated.0dw1'>
            <column caption='顧客ID' datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column caption='カテゴリ' datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='売上' datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column caption='顧客別売上(FIXED)' datatype='real' name='[Calculation_1000000000003]' role='measure' type='quantitative' />
            <column caption='売上ランク' datatype='integer' name='[Calculation_1000000000004]' role='measure' type='ordinal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0dw1].[sum:Sales:qk]'>
            <min>1000</min>
            <max>500000</max>
          </filter>
        <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0dw1].[sum:Sales:qk]' />
              <lod column='[federated.0dw1].[Calculation_1000000000003]' />
              <tooltip column='[federated.0dw1].[Calculation_1000000000004]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0dw1].[none:Customer ID:nk]</rows>
        <cols>[federated.0dw1].[none:Category:nk]</cols>
      </table>
      <simple-id uuid='{1BB6B4CB-CC3E-483B-BACB-4E07D4319FB6}' />
    </worksheet>
  </worksheets>

  <dashboards>
    <dashboard name='エグゼクティブサマリー'>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='800' id='1' type='layout-basic' w='1000' x='0' y='0'>
          <zone h='800' id='2' name='地域別売上' w='500' x='0' y='0' />
          <zone h='800' id='3' name='月次売上推移' w='500' x='500' y='0' />
        </zone>
      </zones>
      <simple-id uuid='{DE6B0F5C-C20F-45DA-8D0B-33717DF4776B}' />
    </dashboard>

    <dashboard name='地域ドリルダウン'>
      <size maxheight='900' maxwidth='1200' minheight='900' minwidth='1200' />
      <!-- 想定外の子要素（未対応要素レポートに載るはず） -->
      <future-layout-hint version='9' />
      <zones>
        <zone h='900' id='10' type='layout-basic' w='1200' x='0' y='0'>
          <zone h='150' id='11' type='layout-flow' w='1200' x='0' y='0'>
            <zone h='150' id='12' param='title' type='text' w='1200' x='0' y='0' />
          </zone>
          <zone h='750' id='13' name='利益率散布図' w='600' x='0' y='150' />
          <zone h='750' id='14' name='顧客別集計(クロス集計)' w='600' x='600' y='150' />
        </zone>
      </zones>
      <simple-id uuid='{5740148A-0911-4C0D-961C-7C52D21DD40A}' />
    </dashboard>
  </dashboards>

  <actions>
    <action name='[action1]' caption='地域でフィルタ' activation='select'>
      <source>
        <worksheet name='地域別売上' />
      </source>
      <target>
        <worksheet name='月次売上推移' />
      </target>
      <filter>
        <link-field dst-field='[Region]' src-field='[Region]' />
      </filter>
    </action>
    <action name='[action2]' caption='詳細をWebで見る' activation='menu'>
      <source>
        <worksheet name='顧客別集計(クロス集計)' />
      </source>
      <url>https://example.com/detail</url>
    </action>
    <action name='[action3]' caption='将来のアクション種別' activation='automatic'>
      <source>
        <worksheet name='顧客別集計(クロス集計)' />
      </source>
      <extension-action ext-id='com.example.custom' />
    </action>
  </actions>
</workbook>
